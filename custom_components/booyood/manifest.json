{
  "domain": "booyood",
  "name": "Nordkapp & Booyood Diesel Heater BLE",
  "version": "1.1.0",
  "documentation": "https://github.com/custom-components/nordkapp-booyood-ble",
  "issue_tracker": "https://github.com/custom-components/nordkapp-booyood-ble/issues",
  "dependencies": ["bluetooth"],
  "requirements": ["bleak>=0.21.0", "bleak-retry-connector>=3.5.0"],
  "codeowners": ["@custom"],
  "config_flow": true,
  "iot_class": "local_polling",
  "bluetooth": [
    {
      "local_name": "BYD*"
    },
    {
      "local_name": "BAC*"
    },
    {
      "local_name": "NK_*"
    },
    {
      "local_name": "NK-*"
    },
    {
      "local_name": "Nordkapp*"
    }
  ]
}
